{
    "name": "@btc-vision/cli",
    "version": "1.0.0",
    "type": "module",
    "description": "CLI for the OPNet plugin ecosystem - scaffolding, compilation, signing, and registry interaction",
    "author": "OP_NET",
    "license": "Apache-2.0",
    "homepage": "https://opnet.org",
    "repository": {
        "type": "git",
        "url": "git://github.com/btc-vision/opnet-cli.git"
    },
    "bugs": {
        "url": "https://github.com/btc-vision/opnet-cli/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "bin": {
        "opnet": "./build/index.js"
    },
    "exports": {
        ".": {
            "import": "./build/index.js",
            "require": "./build/index.js",
            "types": "./build/index.d.ts"
        }
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "typings": "build/index.d.ts",
    "module": "build/index.js",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "scripts": {
        "build": "gulp build",
        "watch": "gulp watch",
        "clean": "gulp clean",
        "lint": "eslint src/",
        "format": "prettier --write src/",
        "start": "node build/index.js",
        "test": "echo \"Tests not yet implemented\""
    },
    "dependencies": {
        "@btc-vision/bitcoin": "^6.4.11",
        "@btc-vision/bip32": "^6.0.3",
        "@btc-vision/logger": "^1.0.0",
        "@btc-vision/transaction": "^1.7.19",
        "opnet": "^1.7.17",
        "bytenode": "^1.5.8",
        "chalk": "^5.4.2",
        "commander": "^14.0.0",
        "esbuild": "^0.25.5",
        "inquirer": "^13.1.0",
        "ora": "^8.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/bytenode": "^1.4.1",
        "@types/inquirer": "^9.0.7",
        "@types/node": "^24.3.0",
        "eslint": "^9.39.1",
        "gulp": "^5.0.1",
        "gulp-cached": "^1.1.1",
        "gulp-clean": "^0.4.0",
        "gulp-eslint-new": "^2.4.0",
        "gulp-logger-new": "^1.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.1"
    },
    "keywords": [
        "opnet",
        "cli",
        "plugin",
        "bitcoin",
        "typescript",
        "blockchain",
        "mldsa",
        "quantum"
    ]
}
