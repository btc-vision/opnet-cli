{
    "name": "@btc-vision/cli",
    "version": "1.1.0",
    "type": "module",
    "description": "CLI for the OPNet plugin ecosystem - scaffolding, compilation, signing, and registry interaction",
    "author": "OP_NET",
    "license": "Apache-2.0",
    "homepage": "https://opnet.org",
    "repository": {
        "type": "git",
        "url": "git://github.com/btc-vision/opnet-cli.git"
    },
    "bugs": {
        "url": "https://github.com/btc-vision/opnet-cli/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "bin": {
        "opnet": "./build/index.js"
    },
    "exports": {
        ".": {
            "import": "./build/index.js",
            "require": "./build/index.js",
            "types": "./build/index.d.ts"
        }
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "typings": "build/index.d.ts",
    "module": "build/index.js",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "gulp build",
        "postbuild": "node -e \"if(process.platform!=='win32'){require('fs').chmodSync('build/index.js',0o755)}\"",
        "watch": "gulp watch",
        "clean": "gulp clean",
        "lint": "eslint src/",
        "format": "prettier --write src/",
        "start": "node build/index.js",
        "test": "echo \"Tests not yet implemented\"",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@btc-vision/bip32": "^7.1.2",
        "@btc-vision/bitcoin": "^7.0.0-rc.4",
        "@btc-vision/ecpair": "^4.0.5",
        "@btc-vision/logger": "^1.0.8",
        "@btc-vision/plugin-sdk": "^1.0.0",
        "@btc-vision/transaction": "^1.8.0-rc.4",
        "@inquirer/prompts": "^8.2.1",
        "bytenode": "^1.5.7",
        "commander": "^14.0.3",
        "esbuild": "^0.27.3",
        "opnet": "^1.8.1-rc.3",
        "ora": "^9.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.2.3",
        "eslint": "^10.0.0",
        "gulp": "^5.0.1",
        "gulp-cached": "^1.1.1",
        "gulp-clean": "^0.4.0",
        "gulp-eslint-new": "^2.6.0",
        "gulp-logger-new": "^1.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0"
    },
    "keywords": [
        "opnet",
        "cli",
        "plugin",
        "bitcoin",
        "typescript",
        "blockchain",
        "mldsa",
        "quantum"
    ]
}
